<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AllTargetFrameworks)</TargetFrameworks>
    <!-- The package id is deliberately not the assembly name: nuget.org reserves the OpenCode.
         prefix for another owner, so the shipped assembly and every public namespace stay
         OpenCode.Sdk while the artifact is published under the package id prefix. -->
    <PackageId>OpenCodeDotNet.Sdk</PackageId>
    <Description>Unofficial .NET SDK for OpenCode: a typed client for the OpenCode 2.x server HTTP API (OpenCode 1.x servers are not supported), with server-sent event streams, PTY and persistent-PTY terminals over WebSockets, cursor pagination, typed errors, and a local server launcher. The package id is $(PackageId); the assembly and every namespace are OpenCode.Sdk.</Description>
    <PackageTags>opencode;sdk;client;http-client;openapi;ai;agent;llm;sse;streaming;pty;terminal;dotnet;csharp</PackageTags>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <!-- The LibraryImport generator emits its P/Invoke stubs as unsafe code and refuses to run
         without this switch (SYSLIB1062). It exists for that generated stub alone: the SDK's
         hand-written code carries no unsafe block, and the switch reaches no consumer — it is a
         compiler option of this project, not a package property (ADR-0026). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep source-only polyfills hidden from friend test assemblies, which compile their own copy. -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
    <!-- Roslyn workspace matching needs project-produced reference assemblies for downlevel multi-TFM references. -->
    <ProduceReferenceAssembly Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net472'">true</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- IAsyncEnumerable is a BCL type from net8.0 on, so only the downlevel targets need the
       package. The streaming surface returns it publicly, which is why the dependency is
       declared here rather than left to arrive through System.Text.Json's graph. -->
  <!-- Span/Memory and ArrayPool are inbox from net8.0 on; the runtime compiles against them
       directly on every target, so the downlevel bridges are declared here rather than left
       to arrive through System.Text.Json's graph (the dependency rule in
       docs/architecture/platform-and-packaging.md). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <!-- FrozenDictionary backs the generated union tag tables; System.Collections.Frozen is inbox
       from net8.0 on, so only the downlevel targets need the package carrying it (the dependency
       rule in docs/architecture/platform-and-packaging.md). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>

  <!-- .NET Framework ships HttpClient in this framework assembly; no NuGet HTTP stack is added. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Implicit usings apply only on net6.0+; downlevel targets need these globally too. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'netstandard2.0'">
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

</Project>

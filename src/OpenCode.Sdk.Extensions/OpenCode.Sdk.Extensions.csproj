<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AllTargetFrameworks)</TargetFrameworks>
    <!-- See OpenCode.Sdk.csproj: the package id differs from the assembly name on purpose. -->
    <PackageId>OpenCodeDotNet.Sdk.Extensions</PackageId>
    <Description>Dependency injection for the unofficial OpenCode .NET SDK: AddOpenCode registers one client for the OpenCode 2.x server HTTP API and every sub-client resolved from it.</Description>
    <PackageTags>opencode;sdk;dependency-injection;di;options;hosting;dotnet;csharp</PackageTags>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <!-- slopwatch-ignore: SW005 experimental-family arbitration: the package registers the SDK's experimental clients (OPENCODE001 and OPENCODE002) without exposing them; the consumer who resolves one opts in -->
    <NoWarn>$(NoWarn);OPENCODE001;OPENCODE002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenCode.Sdk/OpenCode.Sdk.csproj"/>
  </ItemGroup>

</Project>

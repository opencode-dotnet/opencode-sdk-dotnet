# process identity is a value, not an operation. Winner: the synchronous process-identity seam;
# MA0045 remains enabled for every other file.
[src/OpenCode.Sdk/Internal/BackgroundService/ProcessControl/ServiceProcessControl.cs]
dotnet_diagnostic.MA0045.severity = none

# ProcessMark.TryRead reads /proc/<pid>/stat on Linux for the start marker and the zombie state: a

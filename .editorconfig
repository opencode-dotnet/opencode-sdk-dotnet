# Optional<T> is the tri-state carrier for a request property the document declares both optional
# and nullable. CA1000 guards against statics on a generic type whose argument a caller cannot
# infer; here naming the argument is the point, because Optional<string?>.Null is how a caller
# spells "write JSON null for this wire member" where no value exists to infer it from. Winner:
# the explicit null spelling; CA1000 remains enabled for every other file.
# CA2225 demands a named alternate for the implicit conversion. The alternate it names would be
# either a static on the same generic type (CA1000 again) or an instance method that converts
# nothing; the conversion exists so an ordinary object initializer keeps assigning Shell = "pwsh"
# across the generated request surface. Winner: the object-initializer contract; CA2225 remains
# enabled for every other file.
[src/OpenCode.Sdk/Optional.cs]
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA2225.severity = none

# The standalone launcher awaits the tasks of its own child: the exit watch's completion, which a
# thread of the watch completes, and the line readers' loops, which the pump started. Every await
# inside them declines context capture, so no foreign synchronization context is involved, and
# BoundedWait takes exactly those owned tasks. Winner: owned child observation; VSTHRD003 remains
# enabled for every other file. Each entry names one file.
[src/OpenCode.Sdk/Internal/Launcher/BoundedWait.cs]
dotnet_diagnostic.VSTHRD003.severity = none


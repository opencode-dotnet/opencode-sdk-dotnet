# dependency. Winner: owned cleanup observation; VSTHRD003 remains enabled elsewhere.
[tests/Shared/Ownership/OwnedCleanup.cs]
dotnet_diagnostic.VSTHRD003.severity = none

# OwnedEventReader is the reader half of that same contract: it retains the enumeration task a

dotnet_diagnostic.VSTHRD003.severity = none

# The POSIX exit watch is a dedicated background thread that blocks in waitid by design: a
# blocking wait on its own thread holds no pool thread, and no async form of waitid exists. When
# the kernel reaps the child itself, the same thread sleeps between probes, which is the bounded
# fallback the watch documents. Winner: the dedicated exit-watch thread; MA0045 remains enabled
# for every other file.
[src/OpenCode.Sdk/Internal/Posix/PosixChildExitWatch.cs]
dotnet_diagnostic.MA0045.severity = none


[src/OpenCode.Sdk/Internal/Pipeline.cs]
dotnet_diagnostic.CA5399.severity = none

# TerminalSocketCore deliberately never disposes its send-gate SemaphoreSlim. The BCL only requires
# disposal once AvailableWaitHandle has been read, which this class never does, and disposing it
# would break disposal itself: an in-flight write's Release would throw over its own mapped
# failure, and a writer already parked in WaitAsync would never wake, because Dispose does not
# complete pending async waiters. Winner: the disposal-race contract; CA2213 remains enabled for
# every other file.
[src/OpenCode.Sdk/Internal/TerminalSocketCore.cs]
dotnet_diagnostic.CA2213.severity = none

# CallerStreamContent holds two disposables it does not own: the caller's request-body stream,
# which the SDK promises never to dispose or rewind, and the pipeline message whose progress
# window it restarts, which the pipeline disposes after the exchange. Disposing either would break
# that ownership. Winner: the ownership contract; CA2213 remains enabled for every other file.
[src/OpenCode.Sdk/Internal/CallerStreamContent.cs]
dotnet_diagnostic.CA2213.severity = none

# DriveController deliberately never disposes its send-gate and invocation-signal semaphores.
# The BCL only requires SemaphoreSlim disposal once AvailableWaitHandle has been read, which
# this class never does, and disposing them would break disposal itself: a WaitForRequestAsync
# caller parked in WaitAsync would never wake, because Dispose does not complete pending async
# waiters. Winner: the disposal-race contract; CA2213 remains enabled for every other file.
[tests/Shared/DriveController.cs]
dotnet_diagnostic.CA2213.severity = none

# DriveProtocol.Compose builds one JSON-RPC message into an in-memory MemoryStream through a
# `using var writer = new Utf8JsonWriter(buffer)`; Utf8JsonWriter implements IAsyncDisposable,
# which is what MA0045 reacts to, but the write is pure in-memory buffering with no I/O to await,
# and every composing method's public contract returns `byte[]` synchronously (the controller
# calls them as plain value transforms, not async operations). Making Compose async would ripple
# a needless Task allocation into every DriveProtocol call site for no real asynchrony. Winner:
# the synchronous protocol-composition contract; MA0045 remains enabled for every other file.
[tests/Shared/DriveProtocol.cs]
dotnet_diagnostic.MA0045.severity = none

# DriveManifest.Write has the same in-memory Utf8JsonWriter shape as DriveProtocol.Compose, plus

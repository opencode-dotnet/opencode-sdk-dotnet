dotnet_diagnostic.MA0196.severity = suggestion
dotnet_diagnostic.MA0197.severity = none
dotnet_diagnostic.MA0198.severity = suggestion
dotnet_diagnostic.MA0199.severity = suggestion
dotnet_diagnostic.MA0200.severity = suggestion
dotnet_diagnostic.MA0201.severity = error
dotnet_diagnostic.MA0202.severity = error
dotnet_diagnostic.MA0203.severity = suggestion

# =============================================================================
# SECTION 11: ROSLYNATOR (RCSxxxx)
# =============================================================================
dotnet_diagnostic.RCS1214.severity = error
dotnet_diagnostic.RCS1181.severity = error
dotnet_diagnostic.RCS1140.severity = suggestion
dotnet_diagnostic.RCS1141.severity = suggestion

# =============================================================================
# SECTION 12: SONARANALYZER (Sxxxx)
# =============================================================================
# Policy: only arbitrated rules are listed; everything else rides SonarWay
# defaults, which TreatWarningsAsErrors escalates to error. When a Sonar rule
# misfires, arbitrate it here with a
# comment naming the winner.
dotnet_diagnostic.S125.severity = suggestion
dotnet_diagnostic.S2094.severity = suggestion
dotnet_diagnostic.S2437.severity = error
dotnet_diagnostic.S2479.severity = suggestion
dotnet_diagnostic.S3925.severity = none
# Utility classes are static in this repo; keep disabled defensively
dotnet_diagnostic.S1118.severity = none
dotnet_diagnostic.S3963.severity = error
dotnet_diagnostic.S4457.severity = suggestion
dotnet_diagnostic.S6602.severity = none

# =============================================================================
# SECTION 13: COMPILER DIAGNOSTICS (CSxxxx)
# =============================================================================
# Every public member on the shipped surface is documented: generated docs come from the
# spec, hand-written docs by hand. Tests are exempted in Section 15.
dotnet_diagnostic.CS1591.severity = error

# =============================================================================
# SECTION 14: GENERATED CODE
# =============================================================================
# The model-layer generator emits plain .cs files that deliberately avoid every
# generated-code heuristic (no .g.cs name, no <auto-generated> header, no
# [GeneratedCode]) - its output faces the full analyzer wall on merit, so this
# section never matches it. It exists for genuine third-party generated files.
# None of this exempts compiler diagnostics - generated code must compile clean.
[*.{g.cs,generated.cs,designer.cs}]
generated_code = true

# =============================================================================
# SECTION 15: TEST PROJECT OVERRIDES
# =============================================================================
[{*Tests/**/*.cs,tests/**/*.cs}]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS1591.severity = none

# TUnit Assert.That reports false positives for MA0042 because the analyzer cannot model the assertion API shape.
dotnet_diagnostic.MA0042.severity = none

# No SynchronizationContext in tests - the src-side ConfigureAwait triple
# (CA2007/MA0004/VSTHRD111) is noise here
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.VSTHRD111.severity = none

# =============================================================================
# FILE-BASED ENTRY ARBITRATION (MA0048)
# =============================================================================
# Placed after every global C# diagnostic section so the file-scoped glob never
# narrows a later section. MA0048 (file name = type name) cannot apply to the
# file-based tool entry: the SDK synthesizes the Program type, and the entry
# contract pins the file name (it is the tool name:
# ./tools/opencode-tool.cs). Winner: the entry contract; the rule stays error
# for every other file, generated output included (emission keeps file = type).
[tools/opencode-tool.cs]
dotnet_diagnostic.MA0048.severity = none


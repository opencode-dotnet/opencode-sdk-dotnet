# (DriveManifestTests calls it without awaiting), matching the manifest-writing seam the drive
# fixture needs before Task 5's live wiring exists. Winner: the synchronous manifest-writer
# contract; MA0045 remains enabled for every other file.
[tests/Shared/DriveManifest.cs]
dotnet_diagnostic.MA0045.severity = none

# ServerIsolation.Environment seeds one empty shell startup file into the home it names, through

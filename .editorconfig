# DriveManifestTests targets net472 in this project's Windows leg. The regex source generator's
# GeneratedRegexAttribute is not available there (no polyfill covers it), so the instance-name
# check uses a plain static Regex with an explicit match timeout instead — a shape MA0110 always
# flags regardless of TFM feasibility. The manifest readback right after DriveManifest.Write also
# stays synchronous: it reads MockFileSystem's in-memory store, never real I/O, and
# IFile.ReadAllTextAsync is unavailable through this abstraction on the same net472 leg. Winner:
# the cross-TFM test shape; MA0110/CA1849/VSTHRD103/S6966 remain enabled for every other file.
[tests/OpenCode.Sdk.Tests/DriveManifestTests.cs]
dotnet_diagnostic.MA0110.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.VSTHRD103.severity = none
dotnet_diagnostic.S6966.severity = none


# remains enabled for every other file.
[tests/Shared/ProcessMark.cs]
dotnet_diagnostic.MA0045.severity = none

# HeldProcess waits for a process it holds to be finished by registering the process handle with
# ThreadPool.RegisterWaitForSingleObject, which takes a WaitHandle, so the handle is lent to a
# non-owning SafeWaitHandle as a raw value (S3869). The Process keeps its SafeProcessHandle alive and
# undisposed across the wait, the registration is unregistered before the Process is disposed, and
# the raw value is never stored past the wait. The alternative, Process.WaitForExit(int) on a
# thread-pool thread, blocks one thread per held process for the whole settle bound. Winner: an
# asynchronous handle wait; S3869 remains enabled for every other file.
[tests/Shared/HeldProcess.cs]
dotnet_diagnostic.S3869.severity = none


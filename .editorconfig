dotnet_diagnostic.VSTHRD114.severity = error
dotnet_diagnostic.VSTHRD200.severity = suggestion

# =============================================================================
# SECTION 10: MEZIANTOU.ANALYZER (MAxxxx)
# =============================================================================

# -----------------------------------------------------------------------------
# 10.1 Configuration
# -----------------------------------------------------------------------------
MA0051.maximum_lines_per_method = 80
MA0051.maximum_statements_per_method = 60
MA0011.exclude_tostring_methods = true
# Align MA0004 coverage with CA2007 (default DetectContext goes quiet in
# context-dependent code; Always reports every await without ConfigureAwait)
MA0004.report = Always
# Public API ships sealed-by-default (extend-only design); CA1852 covers internal only.
# The stricter class_with_virtual_member_shoud_be_sealed option (sic, upstream typo) is
# deliberately NOT enabled: client facade types are unsealed with virtual members + a
# protected ctor as the consumer mocking seam — a class with virtual members is
# inheritance-by-design and must stay exempt from the seal rule.
MA0053.public_class_should_be_sealed = true
# -----------------------------------------------------------------------------
# 10.2 String/Culture Rules
# [OVERLAP GROUP] - Also enforced by CA1304-CA1311 (§6.2)
# Both sides kept at error; MA0075/MA0076 cover implicit ToString call sites
# (concatenation/interpolation) the CA rules do not see
# -----------------------------------------------------------------------------
# MA0001 ≈ CA1307, CA1309, CA1310 (StringComparison)
# MA0011 ≈ CA1304, CA1305, CA1311 (IFormatProvider/CultureInfo)
# MA0074 ≈ CA1307, CA1309 (Equals StringComparison)
dotnet_diagnostic.MA0001.severity = error
dotnet_diagnostic.MA0006.severity = suggestion
dotnet_diagnostic.MA0011.severity = error
dotnet_diagnostic.MA0074.severity = error
dotnet_diagnostic.MA0075.severity = error
dotnet_diagnostic.MA0076.severity = error

# -----------------------------------------------------------------------------
# 10.3 Async Rules
# [OVERLAP GROUP] - Also enforced by VSTHRD and CA
# MA0042 ≈ CA1849/VSTHRD103 (all error - deliberate double coverage);
# MA0045 is the stricter make-it-async sibling (Meziantou default: off)
# -----------------------------------------------------------------------------
# ConfigureAwait(false) mandatory in library code; report mode set in §10.1
dotnet_diagnostic.MA0004.severity = error
dotnet_diagnostic.MA0022.severity = error
dotnet_diagnostic.MA0042.severity = error
dotnet_diagnostic.MA0045.severity = error
dotnet_diagnostic.MA0080.severity = error
dotnet_diagnostic.MA0089.severity = error
dotnet_diagnostic.MA0152.severity = error

# -----------------------------------------------------------------------------
# 10.4 Performance Rules (unique to MA or stricter)
# -----------------------------------------------------------------------------
dotnet_diagnostic.MA0028.severity = error
dotnet_diagnostic.MA0029.severity = error
dotnet_diagnostic.MA0044.severity = error
dotnet_diagnostic.MA0063.severity = error
dotnet_diagnostic.MA0078.severity = error
dotnet_diagnostic.MA0105.severity = error
dotnet_diagnostic.MA0106.severity = error
dotnet_diagnostic.MA0111.severity = error

# -----------------------------------------------------------------------------
# 10.5 Design Rules
# -----------------------------------------------------------------------------
# File name must match type name (Go-style structure discipline)
dotnet_diagnostic.MA0048.severity = error
dotnet_diagnostic.MA0052.severity = error
# Seal classes including public ones (option in §10.1); CA1852 handles internal only
dotnet_diagnostic.MA0053.severity = error
dotnet_diagnostic.MA0067.severity = error
dotnet_diagnostic.MA0102.severity = error
dotnet_diagnostic.MA0110.severity = error

# -----------------------------------------------------------------------------
# 10.6 Disabled Rules (overlap with CA - using CA versions)
# -----------------------------------------------------------------------------
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0018.severity = none

# -----------------------------------------------------------------------------
# 10.7 Meziantou 3.x Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.MA0180.severity = suggestion
dotnet_diagnostic.MA0181.severity = none
dotnet_diagnostic.MA0182.severity = suggestion
dotnet_diagnostic.MA0183.severity = error
dotnet_diagnostic.MA0184.severity = error
# MA0185 is semantics-preserving: it removes string.Create(CultureInfo.InvariantCulture, ...)
# only when every interpolation is culture-invariant; RCS1140/RCS1141 stay suggestion (best-effort)
dotnet_diagnostic.MA0185.severity = error
dotnet_diagnostic.MA0186.severity = suggestion
dotnet_diagnostic.MA0187.severity = none
dotnet_diagnostic.MA0188.severity = suggestion
dotnet_diagnostic.MA0189.severity = suggestion
dotnet_diagnostic.MA0190.severity = suggestion
dotnet_diagnostic.MA0191.severity = suggestion
dotnet_diagnostic.MA0192.severity = suggestion
dotnet_diagnostic.MA0193.severity = suggestion
dotnet_diagnostic.MA0194.severity = suggestion

# the stream on its own async path and closes it there; disposal is the second, idempotent close.
# Winner: the synchronous disposal contract; MA0045 remains enabled for every other file.
[src/OpenCode.Sdk/Internal/BackgroundService/Contender/ServiceContender.cs]
dotnet_diagnostic.MA0045.severity = none


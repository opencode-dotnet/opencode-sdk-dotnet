# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0043.severity = error
dotnet_diagnostic.IDE0270.severity = error

# =============================================================================
# SECTION 6: CODE QUALITY - DESIGN (CA1xxx)
# =============================================================================

# -----------------------------------------------------------------------------
# 6.1 Type Design (CA1000-CA1099)
# -----------------------------------------------------------------------------
# Static members on generic types (MA0018 disabled in §10.6 in favor of this rule)
dotnet_diagnostic.CA1000.severity = error
dotnet_diagnostic.CA1008.severity = suggestion
dotnet_diagnostic.CA1012.severity = error
dotnet_diagnostic.CA1018.severity = error
# Mark enums with FlagsAttribute [opinionated]
dotnet_diagnostic.CA1027.severity = none
# Catch-general-exception: active rule, deliberately off [opinionated] -
# transport/pipeline code catches broadly by design
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1032.severity = error
dotnet_diagnostic.CA1040.severity = suggestion
dotnet_diagnostic.CA1047.severity = error
# Null-guard externally visible parameters: generated methods emit throw-helper
# guards mechanically; hand-written code must match the same discipline
dotnet_diagnostic.CA1062.severity = error
dotnet_diagnostic.CA1063.severity = error
dotnet_diagnostic.CA1064.severity = error
dotnet_diagnostic.CA1068.severity = error
dotnet_diagnostic.CA1069.severity = error


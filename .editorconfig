# subscription is attached, and wait for a correlated event, without polling or sleeping. Its own
# proofs drive that bridge from a scripted stream, awaiting the same signals plus the scenario's
# stall handle, and release and drain every one of them in finally. Winner: the single-reader
# event probe; VSTHRD003 remains enabled for every other file.
[tests/OpenCode.Sdk.Tests/Support/SessionEventProbe.cs]
dotnet_diagnostic.VSTHRD003.severity = none

[tests/OpenCode.Sdk.Tests/Support/SessionEventProbeTests.cs]
dotnet_diagnostic.VSTHRD003.severity = none


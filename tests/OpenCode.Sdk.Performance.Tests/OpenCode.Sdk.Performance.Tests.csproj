<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(DefaultTargetFramework)</TargetFrameworks>
    <!-- The net472 target measures the downlevel runtime itself and can only execute on Windows;
         adding it conditionally keeps Linux/macOS builds single-target. IncludeNet472Tests adds it
         elsewhere for a build that only compiles, such as the CI lint job's analyzer build. -->
    <TargetFrameworks Condition="'$(BuildOs)' == 'windows' Or '$(IncludeNet472Tests)' == 'true'">net472;$(TargetFrameworks)</TargetFrameworks>
    <!-- BenchmarkDotNet refuses to measure unoptimized assemblies. -->
    <Optimize>true</Optimize>
    <!-- Everything measured goes through the source-generated context, exactly like the SDK. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- .NET Framework reads feature switches from App.config rather than runtimeconfig.json. -->
    <AppConfig Condition="'$(TargetFramework)' == 'net472'">App.net472.config</AppConfig>
    <!-- slopwatch-ignore: SW005 benchmark-harness arbitration: the canned endpoint/credential ARE the fixture, not a real address or secret (S1075, S2068) -->
    <NoWarn>$(NoWarn);S1075;S2068</NoWarn>
    <!-- slopwatch-ignore: SW005 experimental-family arbitration: these tests exercise the SDK's experimental families (OPENCODE001-003) on purpose -->
    <NoWarn>$(NoWarn);OPENCODE001;OPENCODE002;OPENCODE003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenCode.Sdk/OpenCode.Sdk.csproj"/>
    <Compile Include="../Shared/BenchmarkExitPolicy.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- The generator benchmarks measure the repository tool, which targets the default framework only.
       The .NET Framework leg measures the SDK alone. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <ProjectReference Include="../../tools/OpenCode.Sdk.Tools/OpenCode.Sdk.Tools.csproj"/>
  </ItemGroup>

  <!-- .NET Framework ships HttpClient in this framework assembly; no NuGet HTTP stack is added. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Include="../../tools/OpenCode.Sdk.Tools/Benchmarks/WireMetricIds.cs" Link="Support/WireMetricIds.cs" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Implicit usings apply only on net6.0+; the net472 leg needs these globally too. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures/**/*.json" />
  </ItemGroup>

</Project>

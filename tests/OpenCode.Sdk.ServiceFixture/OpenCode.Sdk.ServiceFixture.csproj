<Project Sdk="Microsoft.NET.Sdk">

  <!-- The isolated discovery process: a tiny executable the live tests launch with an environment
       they control entirely, so DiscoverAsync's environment reading is proven from a process that
       never sees the developer's own registration. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenCode.Sdk/OpenCode.Sdk.csproj" />
    <PackageReference Include="Testably.Abstractions" />
  </ItemGroup>

  <!-- The Ensure mode records its contenders in the ledger the launching test reads. -->
  <ItemGroup>
    <Compile Include="../Shared/ContenderLedger.cs" LinkBase="Shared" />
    <Compile Include="../Shared/ProcessMark.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- The handle-cycles mode counts the launcher's handle kinds the way the census self-test proves. -->
  <ItemGroup>
    <Compile Include="../Shared/LauncherHandleCensus.cs" LinkBase="Shared" />
    <Compile Include="../Shared/LauncherHandles.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>

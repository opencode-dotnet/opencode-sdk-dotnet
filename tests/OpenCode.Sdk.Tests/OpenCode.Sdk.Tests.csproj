<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- net472 tests run on Windows only; adding the TFM conditionally keeps Linux/macOS legs green.
         IncludeNet472Tests adds it elsewhere for a build that only compiles, such as the CI lint
         job's analyzer build. -->
    <TargetFrameworks Condition="'$(BuildOs)' == 'windows' Or '$(IncludeNet472Tests)' == 'true'">net472;$(TargetFrameworks)</TargetFrameworks>
    <!-- .NET Framework reads feature switches from App.config rather than runtimeconfig.json. -->
    <AppConfig Condition="'$(TargetFramework)' == 'net472'">App.net472.config</AppConfig>
    <!-- slopwatch-ignore: SW005 experimental-family arbitration: these tests exercise the SDK's experimental families (OPENCODE001 and OPENCODE002) on purpose -->
    <NoWarn>$(NoWarn);OPENCODE001;OPENCODE002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit"/>
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump"/>
    <PackageReference Include="NSubstitute"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="PublicApiGenerator"/>
    <PackageReference Include="System.Reflection.MetadataLoadContext"/>
    <PackageReference Include="Verify.TUnit"/>
    <PackageReference Include="Testably.Abstractions"/>
    <PackageReference Include="Testably.Abstractions.Testing"/>
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenCode.Sdk/OpenCode.Sdk.csproj"/>
  </ItemGroup>

  <PropertyGroup>
    <ShippedAssetProject>../../src/OpenCode.Sdk/OpenCode.Sdk.csproj</ShippedAssetProject>
  </PropertyGroup>
  <Import Project="../Shared/ShippedAssets.targets" />

  <!-- Cross-project test support compiles into each consuming test project as shared source. -->
  <ItemGroup>
    <Compile Include="../Shared/BenchmarkExitPolicy.cs" LinkBase="Shared" />
    <Compile Include="../Shared/BestEffortDelete.cs" LinkBase="Shared" />
    <Compile Include="../Shared/ContenderLedger.cs" LinkBase="Shared" />
    <Compile Include="../Shared/FixtureLoader.cs" LinkBase="Shared" />
    <Compile Include="../Shared/GeneratorPeakMemoryPolicy.cs" LinkBase="Shared" />
    <Compile Include="../Shared/LauncherHandleCensus.cs" LinkBase="Shared" />
    <Compile Include="../Shared/LauncherHandles.cs" LinkBase="Shared" />
    <Compile Include="../Shared/ProcessMark.cs" LinkBase="Shared" />
    <Compile Include="../Shared/ShippedAssetSurface.cs" LinkBase="Shared" />
    <Compile Include="../Shared/TestCategories.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- .NET Framework ships HttpClient in this framework assembly; no NuGet HTTP stack is added. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- The downlevel taskkill tests read process parentage and command lines through WMI, which
       .NET Framework ships in this framework assembly. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- Implicit usings apply only on net6.0+; the net472 leg needs these globally too. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
  </ItemGroup>


@inject SessionTerminal Terminal
@inject SessionBoard Board

<section class="terminal" aria-label="Terminal">
    <p class="meta">A shell in @SessionsScreen.FolderName(Board.Find(SessionId)?.Location.Directory ?? ""), on the machine that runs opencode. Leaving this page closes it.</p>
    @if (Terminal.LastError is { } error)
    {
        <p role="alert">@error</p>
    }
    @if (!Terminal.IsOpen)
    {
        <div><button type="button" @onclick="OpenAsync" disabled="@Terminal.IsOpening">Open a terminal</button></div>
    }
    else
    {
        <pre class="output" tabindex="0" role="log" aria-label="Terminal output">@Terminal.Output</pre>
        <form @onsubmit="SendAsync" @onsubmit:preventDefault>
            <label class="sr" for="command">Command</label>
            <input type="text" id="command" placeholder="Command" @bind="_line" @bind:event="oninput" />
            <button type="submit">Run</button>
        </form>
    }
</section>

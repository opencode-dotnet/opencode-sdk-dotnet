@page "/"
@inject SessionBoard Board

<PageTitle>OpenCode HQ</PageTitle>
<main class="board">
@if (!Board.Connected)
{
    <p class="notice" role="status" style="grid-column: 1 / -1">Not connected to HQ's opencode server. HQ keeps trying, and the board fills again when the connection is back.@(Board.LastError is { } e ? $" Last error: {e}" : null)</p>
}
else
{
    @if (Board.LastError is { } error)
    {
        <p role="alert" style="grid-column: 1 / -1">@error</p>
    }
    <section class="queue @(Board.NeedsYou.Count == 0 ? "clear" : null)" aria-labelledby="needs-you">
        <h1 class="signal" id="needs-you"><span class="mark decide"></span>Needs you<span class="count">@Board.NeedsYou.Count</span></h1>
        @foreach (var item in Board.NeedsYou)
        {
            @if (item.Form is not null)
            {
                <FormCard @key="item.Id" Form="item.Form" ShowSession="true" />
            }
            else
            {
                <PermissionAsk @key="item.Id" Item="item" ShowSession="true" />
            }
        }
        @if (Board.NeedsYou.Count == 0)
        {
            <div class="empty"><p>Nothing needs you. When an agent asks for permission or asks a question, the ask waits here until you answer it.</p></div>
        }
    </section>
    <section class="sessions" aria-labelledby="sessions">
        <h2 id="sessions">Sessions</h2>
        @if (Board.Sessions.Count == 0)
        {
            <div class="empty">
                <p>No sessions yet. Start one: pick a project folder, then send the agent a prompt. Its status shows here while it works.</p>
                <a class="button" href="/sessions/new">New session</a>
            </div>
        }
        else
        {
            <table class="rows">
                <thead><tr><th scope="col">Session</th><th scope="col">Folder</th><th scope="col">Status</th></tr></thead>
                <tbody>
                @foreach (var row in Board.Sessions)
                {
                    <tr>
                        <td class="name"><a href="/sessions/@row.Session.Id">@(string.IsNullOrEmpty(row.Session.Title) ? "Untitled session" : row.Session.Title)</a></td>
                        <td class="folder"><span title="@row.Session.Location.Directory">@FolderName(row.Session.Location.Directory)</span></td>
                        <td>@switch (row.Status)
                        {
                            case "waiting for you":
                                <span class="status waiting"><span class="mark decide"></span>Waiting for you</span>
                                break;
                            case "running":
                                <span class="status running"><span class="mark running"></span>Running</span>
                                break;
                            default:
                                <span class="status idle"><span class="mark idle"></span>Idle</span>
                                break;
                        }</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}
</main>
<SdkPanel Entries="PanelEntry.FirstScreen" Guide="https://github.com/opencode-dotnet/opencode-sdk-dotnet/blob/master/docs/guide/streaming.md" />

@page "/"
@inject SessionBoard Board

<PageTitle>OpenCode HQ</PageTitle>

<div class="screen">
<main>
@if (Board.LastError is { } error)
{
    <p role="alert">@error</p>
}
@if (!Board.Connected)
{
    <p>Not connected to HQ's opencode server. Waiting to reconnect.</p>
}
else
{
<section class="needs-you">
    <h1>Needs you · @Board.NeedsYou.Count</h1>
    @foreach (var item in Board.NeedsYou)
    {
        @if (item.Form is not null)
        {
            <FormCard @key="item.Id" Form="item.Form" />
        }
        else
        {
            <div class="ask">
                <div class="ask-text"><div class="ask-kind">Permission</div><div class="mono">@item.Title</div></div>
                <button class="primary" @onclick="() => AnswerAsync(item, PermissionReply.Once)">Allow once</button>
                <button @onclick="() => AnswerAsync(item, PermissionReply.Reject)">Reject</button>
            </div>
        }
    }
</section>

<section>
    <h2>Sessions</h2>
    <table class="sessions">
        <thead><tr><th>Session</th><th>Folder</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var row in Board.Sessions)
        {
            <tr>
                <td><a href="/sessions/@row.Session.Id">@row.Session.Title</a></td>
                <td class="mono">@row.Session.Location.Directory</td>
                <td class="status-@row.Status.Split(' ')[0]">@row.Status</td>
            </tr>
        }
        </tbody>
    </table>
</section>
}
</main>
<SdkPanel Entries="PanelEntry.FirstScreen" Guide="https://github.com/opencode-dotnet/opencode-sdk-dotnet/blob/master/docs/guide/streaming.md" />
</div>

{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet tool run slopwatch analyze -d \"$CLAUDE_PROJECT_DIR\" --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
